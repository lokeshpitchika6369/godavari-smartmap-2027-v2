# Godavari SmartMap 2027 (v2) - Backend Environment Configuration Example
PROJECT_NAME="Godavari SmartMap 2027 API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Origins (Comma separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Security & JWT (Replace with strong secret in production)
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite / PostgreSQL Database URL
DATABASE_URL="sqlite:///./godavari_smartmap_v2.db"

# SMS Service Provider (Optional / Simulation mode by default)
SMS_PROVIDER="simulation"
SMS_API_KEY=""
SMS_SENDER_ID="GDVMP"

